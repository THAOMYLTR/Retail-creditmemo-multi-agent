# Secrets / environment
.env
.env.*
!.env.example

# Logs / run outputs
logs/

# Customer data — never commit
testing/samples/

# docs/ is where bank source material lands: workbooks, scanned application
# forms, screenshots of real customer business models. Ignore everything in it
# and allow the written documentation back in, rather than listing extensions —
# an extension list only covered files sitting directly in docs/, so a folder of
# scanned forms at docs/proposal/ slipped straight past it.
# The routing matrix is transcribed into src/matrix/document_matrix.yaml, which
# IS tracked because the code cannot load without it; the source workbook stays
# local. Keep the two in sync by hand.
docs/*
!docs/*.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OCR / caches
.cache/
*.tmp

# OS / editor
.DS_Store
.vscode/
.idea/
